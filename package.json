{
  "name": "no-ai-style",
  "version": "1.2.1",
  "description": "Academic and professional prose editing for DeepSeek Harness: a skill that removes mechanical AI phrasing, defensive hedging and filler while protecting claims, citations, statistics, methodology and limitations, plus a composer button that inserts one of its three modes into the input box.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib/",
    "cordis.patch.yml",
    "skills/",
    "locale/",
    "docs/",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.3 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "react",
        "react-dom"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "writing",
    "academic-writing",
    "prose-editing",
    "humanize",
    "anti-ai",
    "去ai味",
    "论文润色",
    "写作润色",
    "日本語文章校正"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/01NGVI-QINGYI/no-ai-style.git"
  },
  "license": "MIT",
  "author": "01NGVI-QINGYI",
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": ">=0.1.0-rc.6 <0.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
